# ==================================================================
# Taarifu Engine API - Environment Variables Example
# ==================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control
# ==================================================================

# Database Configuration
# Full JDBC connection URL (optional - can use individual components)
DB_URL=jdbc:mysql://localhost:3306/your_database_name?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true            

# Database credentials
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# Email Configuration (Brevo SMTP)
# MAIL_USERNAME and MAIL_PASSWORD are REQUIRED
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-email@smtp-brevo.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=your-from-email@yourdomain.com

# JWT Configuration
# JWT_SECRET is REQUIRED - Generate with: openssl rand -base64 32
# Should be a base64-encoded string, at least 32 bytes
JWT_SECRET=your-base64-encoded-secret-here
JWT_ACCESS_TOKEN_EXPIRATION=36000
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Root Admin Configuration (Local Development Only)
# These are only used when initializing the first admin user
ROOT_ADMIN_USERNAME=your-root-admin-username
ROOT_ADMIN_PASSWORD=your-root-admin-password
ROOT_ADMIN_EMAIL=your-root-admin-email@yourdomain.com

# SMS Configuration (Optional)
# SMS_USERNAME and SMS_PASSWORD are REQUIRED if SMS_ENABLED=true
SMS_PROVIDER=beem
SMS_USERNAME=your-sms-username
SMS_PASSWORD=your-sms-password
SMS_SENDER_ID=your-sender-id
SMS_ENABLED=true
